
{
  "appId": "com.teip.smartpwa",
  "appName": "TEIP",
  "webDir": ".",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "allowNavigation": ["*"]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#050505",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": true,
      "spinnerColor": "#22d3ee"
    }
  }
}
